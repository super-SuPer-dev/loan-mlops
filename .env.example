# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (docker compose อ่าน .env อัตโนมัติ)
#   cp .env.example .env
# ไฟล์ .env อยู่ใน .gitignore — ห้าม commit เพราะมี URL ลับของ webhook

# Discord webhook สำหรับแจ้งเตือน (ข้อมูลเสีย, drift, promote, rollback)
# สร้าง: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
# เว้นว่าง = แจ้งเตือนลงไฟล์ include/alerts.jsonl อย่างเดียว
ALERT_WEBHOOK_URL=

# คีย์ของ Airflow ใช้ร่วมกันทุก container — เปลี่ยนเป็นค่าสุ่มยาว ๆ
AIRFLOW_SECRET_KEY=loan-mlops-change-me

# user id ที่ Airflow ใช้เขียนไฟล์ลงโฟลเดอร์โปรเจกต์ (Linux ให้ใส่ผลของคำสั่ง id -u)
AIRFLOW_UID=50000
